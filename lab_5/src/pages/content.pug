main.page-content#home
  .market-strip(aria-label="Поточні ринкові індекси")
    each market in [{name: "S&P 500", price: "5,088.80", change: "+0.85%"}, {name: "NASDAQ", price: "16,057.40", change: "+1.12%"}, {name: "BTC / USD", price: "$62,450.00", change: "+3.40%"}]
      article.market-card
        h2.market-name= market.name
        span.market-price= market.price
        span.market-change= market.change
          span.market-arrow(aria-hidden="true") ▲

  section.hero(aria-labelledby="hero-title")
    .hero-copy
      span.eyebrow ІНВЕСТИЦІЙНА ПЛАТФОРМА
      h1#hero-title Розумне управління портфелями та контроль ризиків
      p.hero-description Єдина система для аналізу активів, розрахунку складного відсотка, моніторингу Stop Loss та автоматичного пропорційного розподілу капіталу.
      .hero-actions
        a.button.button--primary(href="#portfolios") Перейти до портфелів
          span(aria-hidden="true") →
        a.button.button--secondary(href="#analytics") Розрахунок ризиків
    article.balance-card(aria-label="Загальний баланс активів")
      .balance-heading Загальний баланс активів
      .balance-amount $128,450.00
      .balance-growth + $14,200 (+12.4%)
      .chart-wrap
        svg.balance-chart(viewBox="0 0 420 170" role="img" aria-label="Графік зростання балансу активів")
          defs
            linearGradient#chart-fill(x1="0" x2="0" y1="0" y2="1")
              stop(offset="0%" stop-color="#398d46" stop-opacity=".16")
              stop(offset="100%" stop-color="#398d46" stop-opacity=".03")
          path.chart-area(d="M 8 142 C 40 131, 68 119, 95 121 S 145 131, 181 111 S 245 52, 274 38 S 320 50, 337 91 S 370 121, 391 79 S 405 37, 412 24 L 412 164 L 8 164 Z")
          path.chart-line(d="M 8 142 C 40 131, 68 119, 95 121 S 145 131, 181 111 S 245 52, 274 38 S 320 50, 337 91 S 370 121, 391 79 S 405 37, 412 24")
          circle.chart-point(cx="412" cy="24" r="6")
      p.balance-caption Оновлено 1 хв тому · Авторозподіл активів

  section.stats-bar(aria-label="Показники платформи")
    each stat in [{value: "$2.4M+", label: "Розрахованого капіталу"}, {value: "100%", label: "Точність Stop Loss алгоритмів"}, {value: "< 0.01 сек", label: "Швидкість авторозподілу коштів"}]
      article.stat-item
        strong.stat-value= stat.value
        span.stat-label= stat.label

  section.features(aria-label="Можливості платформи")
    article.feature-card#portfolios
      .feature-top
        span.feature-icon(aria-hidden="true")
          svg(viewBox="0 0 24 24")
            path(d="M5 19V11M12 19V5M19 19v-8")
        span.feature-number 01
      h2 Дашборд портфелів
      p.feature-description Зручний єдиний вибір портфелів. Перегляд загальної вартості, структури та відсоткової частки акцій у режимі реального часу.
      .feature-info.feature-info--portfolio
        span.portfolio-swatch(aria-hidden="true")
        .feature-info-copy
          strong Основний портфель
          span $24,500.00 (+5.3%)
      a.feature-button(href="#portfolios") Переглянути
        span(aria-hidden="true") →

    article.feature-card#analytics
      .feature-top
        span.feature-icon(aria-hidden="true")
          svg(viewBox="0 0 24 24")
            path(d="m4 16 6-6 4 4 6-8M14 6h6v6")
        span.feature-number 02
      h2 Аналітика та ризики
      p.feature-description Підбір нових активів через пошук з автодоповненням. Розрахунок потенційних збитків через параметри Stop Loss.
      .feature-info.feature-info--risk#risk-details
        strong STOP LOSS РОЗРАХУНОК:
        span -$301.50 збитку
      a.feature-button(href="#risk-details") Розрахувати
        span(aria-hidden="true") →

    article.feature-card#forecasts
      .feature-top
        span.feature-icon.feature-icon--forecast(aria-hidden="true")
          svg(viewBox="0 0 24 24")
            circle(cx="12" cy="12" r="8")
        span.feature-number 03
      h2 Прогнози та бюджети
      p.feature-description Формування прибутку за формулою складного відсотка. Автоматичний пропорційний розподіл коштів при поповненні.
      .feature-info.feature-info--forecast#forecast-details
        strong ПРОГНОЗ (5 РОКІВ):
        span +$18,685.00 прибутку
      a.feature-button(href="#forecast-details") Дізнатися більше
        span(aria-hidden="true") →
