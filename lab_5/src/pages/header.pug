header.site-header
  .header-inner
    a.brand(href="#home" aria-label="InvestAnalytics — на головну") InvestAnalytics
    nav.main-nav#main-navigation(aria-label="Головна навігація")
      a.nav-link.nav-link--active(href="#home" aria-current="page") Головна
      a.nav-link(href="#portfolios") Мої портфелі
      a.nav-link(href="#analytics") Аналітика та ризики
    button.menu-toggle(type="button" aria-label="Відкрити меню" aria-expanded="false" aria-controls="main-navigation")
      svg(viewBox="0 0 24 24" aria-hidden="true" focusable="false")
        path.menu-icon-top(d="M4 7h16")
        path.menu-icon-middle(d="M4 12h16")
        path.menu-icon-bottom(d="M4 17h16")
    .user-avatar(aria-label="Профіль користувача Андрій Дмитренко") А.Д.
